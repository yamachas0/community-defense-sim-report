<!DOCTYPE html>
<html lang="ja"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>外的不動産投資へのコミュニティ自衛 — 提出スライド（10枚）</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0f1115; --panel:#161a21; --fg:#e9ecf1; --dim:#98a1ad;
  --accent:#34d399; --line:#262c36; --pad:20px;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0;height:100%;overflow:hidden;background:var(--bg)}
body{
  color:var(--fg);
  font-family:"Noto Sans JP",system-ui,-apple-system,sans-serif;
  line-height:1.75;-webkit-text-size-adjust:100%;overscroll-behavior:none;
}
#deck{position:fixed;inset:0}
.slide{
  position:absolute;inset:0;display:none;flex-direction:column;
  padding:calc(env(safe-area-inset-top,0px) + 22px) var(--pad)
          calc(env(safe-area-inset-bottom,0px) + 58px) var(--pad);
  overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch;
}
.slide.on{display:flex}
.kicker{font-size:13px;font-weight:700;letter-spacing:.09em;color:var(--accent);margin:0 0 8px;flex:none}
h1{
  font-size:clamp(30px,8.2vw,56px);font-weight:900;line-height:1.32;
  margin:0 0 16px;letter-spacing:.01em;
}
h2{
  font-size:clamp(21px,5.2vw,31px);font-weight:900;line-height:1.4;
  margin:0 0 14px;padding-left:12px;border-left:5px solid var(--accent);
  flex:none;letter-spacing:.01em;
}
.sub{font-size:clamp(18px,4.4vw,23px);font-weight:500;color:var(--dim);line-height:1.7;margin:0 0 18px}
ul.body{list-style:none;margin:0 0 14px;padding:0;flex:none}
ul.body li{
  font-size:clamp(18px,4.2vw,21px);line-height:1.7;margin:0 0 11px;
  padding-left:20px;position:relative;
}
ul.body li::before{
  content:"";position:absolute;left:2px;top:.74em;width:8px;height:8px;
  border-radius:50%;background:var(--accent);
}
ul.body li ul{list-style:none;margin:6px 0 0;padding:0}
ul.body li ul li{font-size:clamp(16px,3.7vw,18px);color:var(--dim);margin:0 0 5px;padding-left:16px}
ul.body li ul li::before{width:5px;height:5px;background:transparent;border:1px solid var(--dim);top:.8em}
strong{font-weight:900}
.hl{color:var(--accent);font-weight:900}
.src{font-size:.78em;color:var(--accent);font-weight:700;vertical-align:.3em;margin-left:2px}
h1.big,.big{font-size:clamp(24px,6.2vw,40px);font-weight:900;line-height:1.55;margin:0 0 18px;letter-spacing:0}
.spacer{flex:1 1 auto;min-height:0}

.read{
  flex:none;border-left:3px solid var(--accent);background:var(--panel);
  border-radius:0 8px 8px 0;padding:11px 14px;margin:0 0 12px;
}
.read .rt{font-size:12px;font-weight:900;letter-spacing:.09em;color:var(--accent);margin:0 0 4px}
.read p{margin:0;font-size:clamp(16px,3.8vw,18px);line-height:1.7;color:var(--fg)}
.figwrap{flex:1 1 auto;min-height:100px;display:flex;align-items:center;justify-content:center;margin:2px 0 8px}
.figwrap img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;border:1px solid var(--line);border-radius:8px;background:#fff}
.figcap{flex:none;font-size:14px;color:var(--dim);margin:0 0 10px;line-height:1.6}
.figwrap.fixed{flex:none;height:230px}

.casewrap{flex:none;display:flex;gap:12px;align-items:center;margin:2px 0 14px}
.jpmap{flex:0 0 148px;max-width:148px}
.jpmap svg{width:100%;height:auto;display:block}
.jpmap .land{fill:#1e2530;stroke:#39424f;stroke-width:1.4}
.jpmap .dot{fill:var(--accent)}
.jpmap .ring{fill:none;stroke:var(--accent);stroke-width:1.6;opacity:.55}
.jpmap .lbl{fill:var(--accent);font-size:17px;font-weight:700;font-family:"Noto Sans JP",sans-serif}
.cases{flex:1 1 auto;min-width:0;display:flex;flex-direction:column;gap:9px}
.case{border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:0 9px 9px 0;background:var(--panel);padding:9px 12px}
.case h3{margin:0 0 3px;font-size:clamp(15px,3.8vw,17px);font-weight:900;line-height:1.4}
.case p{margin:0;font-size:clamp(14px,3.4vw,16px);line-height:1.6;color:#c6cdd7}
.case p b{color:var(--fg);font-weight:900}
.chips{flex:none;display:flex;flex-wrap:wrap;gap:7px;margin:0 0 10px}
.chip{
  border:1px solid var(--line);background:var(--panel);border-radius:999px;
  padding:5px 11px;font-size:clamp(14px,3.5vw,16px);color:var(--fg);
}
.chip b{color:var(--accent);font-weight:900}
.legend{flex:none;display:flex;flex-wrap:wrap;gap:6px 14px;margin:0 0 10px;font-size:14px;color:var(--dim)}
.legend span{display:inline-flex;align-items:center;gap:6px}
.legend i{width:14px;height:14px;border-radius:3px;border:1px solid #0006;display:inline-block}
.flow{list-style:none;margin:0 0 12px;padding:0;flex:none;counter-reset:st}
.flow li{
  position:relative;padding:0 0 0 34px;margin:0 0 11px;
  font-size:clamp(17px,4vw,20px);line-height:1.65;counter-increment:st;
}
.flow li::before{
  content:counter(st);position:absolute;left:0;top:.22em;
  width:23px;height:23px;border-radius:50%;background:var(--accent);color:var(--bg);
  font-size:13px;font-weight:900;display:flex;align-items:center;justify-content:center;
}
@media (min-width:900px){
  .jpmap{flex:0 0 190px;max-width:190px}
  .slide{
    padding-left:max(28px,calc((100vw - 1120px) / 2));
    padding-right:max(28px,calc((100vw - 1120px) / 2));
    padding-top:26px;
  }
}
#bar{
  position:fixed;left:0;right:0;bottom:0;
  height:calc(env(safe-area-inset-bottom,0px) + 46px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  display:flex;align-items:center;justify-content:center;gap:18px;
  background:rgba(15,17,21,.95);border-top:1px solid var(--line);
  font-size:14px;color:var(--dim);z-index:5;
}
#bar button{
  font:inherit;font-weight:700;color:var(--fg);background:#1b2029;
  border:1px solid var(--line);border-radius:8px;padding:5px 14px;cursor:pointer;
}
#bar button:active{border-color:var(--accent)}
#pageno{font-variant-numeric:tabular-nums;font-weight:700;color:var(--fg);min-width:60px;text-align:center}
#prog{position:fixed;left:0;top:0;height:3px;background:var(--accent);z-index:6;transition:width .18s ease}

/* ===== 10枚版の密度調整 ===== */
.slide{padding-bottom:calc(env(safe-area-inset-bottom,0px) + 52px)}
h2{font-size:24px;line-height:1.35;margin:0 0 12px;padding-left:10px;border-left-width:4px}
.kicker{font-size:13px;margin:0 0 7px}
ul.body{margin:0 0 8px}
ul.body li{font-size:18px;line-height:1.65;margin:0 0 9px;padding-left:17px}
ul.body li::before{width:6px;height:6px;left:1px;top:.65em}
ul.body li ul{margin:4px 0 0}
ul.body li ul li{font-size:16px;line-height:1.6;margin:0 0 4px;padding-left:14px}
ul.body li ul li::before{width:4px;height:4px;top:.72em}
.chips{gap:6px;margin:0 0 8px}
.chip{font-size:15px;padding:4px 11px}
.case{padding:7px 10px}
.case h3{font-size:16px}
.case p{font-size:15px;line-height:1.6}
.casewrap{margin:0 0 8px;gap:14px}
.flow{margin:0 0 8px}
.flow li{font-size:16.5px;line-height:1.55;margin:0 0 8px;padding-left:30px}
.flow li::before{width:19px;height:19px;font-size:11px;top:.2em}
.figcap{font-size:13.5px;line-height:1.55;margin:0 0 7px}
.legend{font-size:13px;gap:4px 13px;margin:0 0 7px}
.legend i{width:13px;height:13px}
.read{padding:8px 11px;margin:0 0 8px}
.read p{font-size:15.5px;line-height:1.65}
.read .rt{font-size:11px}

.cols{flex:0 0 auto;display:flex;gap:16px;align-items:flex-start;margin:0 0 6px}
.cols.grow{flex:1 1 auto;min-height:0}
.cols > .c{flex:1 1 0;min-width:0;display:flex;flex-direction:column}
.cols > .c.w40{flex:0 0 40%}
.cols > .c.w34{flex:0 0 34%}
.cols > .c.w30{flex:0 0 30%}
.colhd{font-size:16px;font-weight:900;line-height:1.4;margin:0 0 6px;color:var(--fg)}

.dense ul.body li{font-size:15px;line-height:1.6;margin:0 0 7px}
.dense ul.body li ul li{font-size:13.5px;line-height:1.55;margin:0 0 3px}
.dense .chip{font-size:14px;padding:3px 9px}
.dense .colhd{font-size:15px}
.dense .read p{font-size:14px;line-height:1.6}
.dense .flow li{font-size:15px;line-height:1.5;margin:0 0 7px}

.quote{
  flex:none;border:1px solid var(--accent);border-radius:9px;background:var(--panel);
  padding:10px 12px;margin:0 0 8px;
}
.quote .qt{font-size:11px;font-weight:900;letter-spacing:.08em;color:var(--accent);margin:0 0 5px}
.quote p{margin:0;font-size:13.5px;line-height:1.72;color:var(--fg);white-space:pre-line}

.tbl{flex:none;border:1px solid var(--line);border-radius:9px;background:var(--panel);padding:6px 10px;margin:0 0 8px}
.tbl .r{display:flex;gap:8px;align-items:baseline;font-size:13px;line-height:1.5;color:#c6cdd7;padding:2.5px 0;border-bottom:1px solid #1f242c}
.tbl .r:last-child{border-bottom:0}
.tbl .r b{flex:none;width:40px;color:var(--dim);font-weight:700;font-variant-numeric:tabular-nums}
.tbl .r s{flex:1 1 auto;min-width:0;text-decoration:none;color:var(--fg)}
.tbl .r em{flex:none;font-style:normal;color:var(--accent);font-weight:900;font-variant-numeric:tabular-nums}
.tbl .hd{color:var(--dim);font-size:11.5px;font-weight:700;letter-spacing:.04em}
.planfig{flex:none !important;height:352px;min-height:0 !important}

.foot{
  flex:none;margin-top:auto;border-top:1px solid var(--line);
  padding-top:7px;font-size:11.5px;line-height:1.6;color:#69737f;
}
.foot b{color:#8a94a0;font-weight:700}
.foot a{color:#69737f;text-decoration:none;word-break:break-all}
.byline{font-size:15px;color:var(--dim);margin:14px 0 0;line-height:1.7}
.byline b{color:var(--fg);font-weight:900}

.cases2{flex:none;display:flex;gap:14px;margin:0 0 10px}
.cases2 .case{flex:1 1 0;min-width:0}
.cases2 .case .pin{color:var(--accent);font-size:12px;vertical-align:.15em;margin-right:4px}

.q4{flex:none;border:1px solid var(--line);border-radius:9px;background:var(--panel);overflow:hidden;margin:0 0 10px}
.q4r{display:flex;align-items:stretch;border-bottom:1px solid #1f242c}
.q4r:last-child{border-bottom:0}
.q4r > span{flex:1 1 0;min-width:0;padding:7px 10px;font-size:15px;line-height:1.45;text-align:center;border-left:1px solid #1f242c}
.q4r > span:first-child{flex:0 0 168px;text-align:left;color:var(--dim);font-weight:700;border-left:0}
.q4r b{color:var(--accent);font-weight:900;font-variant-numeric:tabular-nums}
.q4hd{background:#1b212b}
.q4hd > span{font-size:13px;font-weight:900;color:var(--fg);line-height:1.35}
</style></head>
<body>
<div id="prog"></div>
